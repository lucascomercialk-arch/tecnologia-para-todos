# Ambiente de execução: development | test | production
APP_ENV=development

# Porta HTTP em que o FastAPI/Uvicorn irá escutar (1 a 65535)
PORT=3050

# Caminho do banco SQLite (relativo à pasta tpt-tasks-api ou absoluto)
DB_PATH=tpt_tasks.db

# Chave secreta de moderação global (header X-Admin-Key)
# Em development, deixe em branco para gerar automaticamente no primeiro start.
# Em APP_ENV=production, é OBRIGATÓRIO definir uma chave forte (>= 24 caracteres).
ADMIN_KEY=

# Permite gravar ADMIN_KEY gerada no .env em desenvolvimento (em produção é ignorado/false)
AUTO_WRITE_ENV=true

# Token do GitHub (Fine-grained PAT com Issues: Read and write apenas no repositório alvo)
GITHUB_TOKEN=
GITHUB_REPO=lucascomercialk-arch/tecnologia-para-todos

# Origens CORS explícitas (opcional; sem curinga '*', e somente https:// em produção)
# Se vazio em produção, permite apenas https://lucascomercialk-arch.github.io
CORS_ORIGINS=
EXTRA_CORS_ORIGINS=

# Confia em CF-Connecting-IP / X-Forwarded-For apenas quando vier de proxy local/privado
TRUST_PROXY_HEADERS=false

# Limites anti-abuso e tamanho máximo do corpo da requisição
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600
MUTATION_RATE_LIMIT_MAX=30
ADMIN_FAIL_LIMIT_MAX=10
ADMIN_FAIL_WINDOW_SECONDS=900
MAX_OPEN_TASKS_FOR_GITHUB=200
MAX_REQUEST_BODY_BYTES=16384

# Nível de log estruturado JSON (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
