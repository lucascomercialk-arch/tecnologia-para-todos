# Porta HTTP em que o FastAPI/Uvicorn irá escutar
PORT=3050

# Caminho do banco SQLite (relativo à pasta tpt-tasks-api ou absoluto)
DB_PATH=tpt_tasks.db

# Chave secreta de moderação global (header X-Admin-Key)
# Deixe em branco para gerar automaticamente no primeiro start em .env
ADMIN_KEY=

# Token do GitHub (Personal Access Token fine-grained com Issues: Read and write)
GITHUB_TOKEN=
GITHUB_REPO=lucascomercialk-arch/tecnologia-para-todos

# Origens extras de CORS separadas por vírgula (opcional)
EXTRA_CORS_ORIGINS=
