# Copie para /etc/systemd/system/tpt-tasks-api.service e ajuste User/Group para o seu usuário Linux
[Unit]
Description=Tecnologia para Todos - Tasks API (FastAPI + SQLite WAL)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tpt-tasks-api
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/tpt-tasks-api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 3050
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
